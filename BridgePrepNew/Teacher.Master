<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Teacher.master.cs" Inherits="BridgePrep.TeacherMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <title>BridgePrep Teacher Portal</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        /* Layout Wrapper */
        .wrapper { display: flex; width: 100%; min-height: 100vh; }
        
        /* Sidebar Styling */
        .sidebar {
            width: 260px;
            background-color: #0d1424;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            padding: 20px 15px;
            position: fixed;
            height: 100vh;
            top: 0;
            left: 0;
            z-index: 1000;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            font-size: 1.4rem;
            font-weight: 700;
            color: #ffffff;
            text-decoration: none;
            padding-bottom: 20px;
            border-bottom: 1px solid #1e293b;
            margin-bottom: 20px;
        }

        .sidebar-brand i { color: #10b981; margin-right: 10px; font-size: 1.6rem; }

        .nav-menu { display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }

        .nav-item-link {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .nav-item-link i { width: 24px; margin-right: 12px; font-size: 1.1rem; }

        .nav-item-link:hover { background-color: #1e293b; color: #ffffff; }

        /* Active State */
        .nav-item-link.active {
            background-color: #10b981;
            color: #ffffff;
            font-weight: 600;
        }

        /* Logout Link */
        .logout-link {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: #ef4444;
            text-decoration: none;
            border-top: 1px solid #1e293b;
            padding-top: 20px;
            font-weight: 600;
        }

        .logout-link i { margin-right: 12px; font-size: 1.1rem; }
        .logout-link:hover { color: #f87171; }

        /* Main Content Layout Shift */
        .main-content {
            margin-left: 260px;
            flex-grow: 1;
            padding: 30px;
            width: calc(100% - 260px);
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <div class="wrapper">
            <!-- Sidebar Navigation -->
            <div class="sidebar">
                <a href="TeacherDashboard.aspx" class="sidebar-brand">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <span>BridgePrep</span>
                </a>

                <div class="nav-menu">
                    <a href="TeacherDashboard.aspx" class="nav-item-link <%= GetActiveClass("TeacherDashboard.aspx") %>">
                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>
                    </a>

                    <a href="ManageMaterials.aspx" class="nav-item-link <%= GetActiveClass("ManageMaterials.aspx") %>">
                        <i class="fa-solid fa-square-plus"></i>
                        <span>Upload Materials</span>
                    </a>

                    <a href="ManageQuizzes.aspx" class="nav-item-link <%= GetActiveClass("ManageQuizzes.aspx") %>">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Manage Quizzes</span>
                    </a>

                    <a href="ViewPerformance.aspx" class="nav-item-link <%= GetActiveClass("ViewPerformance.aspx") %>">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Student Performance</span>
                    </a>

                    <a href="ManageSubjects.aspx" class="nav-item-link <%= GetActiveClass("ManageSubjects.aspx") %>">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Manage Course Content</span>
                    </a>
                </div>

                <asp:LinkButton ID="btnSidebarLogout" runat="server" CssClass="logout-link" OnClick="btnSidebarLogout_Click">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </asp:LinkButton>
            </div>

            <!-- Page Content Body -->
            <div class="main-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
</body>
</html>